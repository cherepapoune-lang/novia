# ---------------------------------------------------------------------------
# NOVIA — une seule clé suffit pour démarrer. Mets-en plusieurs pour la Fusion.
# Ce fichier est un modèle : renomme-le en .env.local (jamais commité).
# ---------------------------------------------------------------------------

# Google AI Studio — https://aistudio.google.com/apikey  (gratuit)
GEMINI_API_KEY=
# Optionnel : force un modèle précis (sinon gemini-2.5-flash)
GEMINI_MODEL=

# Groq — https://console.groq.com/keys  (gratuit, très rapide)
GROQ_API_KEY=
GROQ_MODEL=

# OpenRouter — https://openrouter.ai/keys  (gratuit, modèles :free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Cloudflare Workers AI (optionnel) — 10 000 Neurons/jour gratuits
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=
